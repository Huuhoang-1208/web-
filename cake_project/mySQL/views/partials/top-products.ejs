<section class="products-section top-products-section">

    <div class="container">

        <h2 class="section-title">
            Top Products
        </h2>

        <p class="product-count">
            <%= products.length %> styles found
        </p>


        <div class="products-grid">

            <% products.forEach(product => { %>

                <%- include("cake-card", {
                    product: product
                }) %>

            <% }) %>

        </div>

    </div>

</section>