<%- include('partials/header', { title: 'Home' }) %>
<main>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <span class="eyebrow">
        HAVEN / CAMPAIGN 01
      </span>
      
      <h1 id="hero-title">NEW ERA<br>STREETWEAR</h1>
      <a class="button-light" href="/shop">SHOP NEW ARRIVALS 
        <span>
          ↗
        </span>
      </a>
    </div>
  </section>

  <section class="arrivals section-pad" id="arrivals">
    <div class="section-heading">
      <div>
        <span class="eyebrow">
          DROP / 01
        </span>
        
        <h2>
          NEW ARRIVALS
        </h2>
      </div>
      
      <a class="text-link" href="/shop">VIEW ALL ↗</a>
    </div>

    <div class="cards-grid"><% featured.forEach(product => { %><%- include('partials/product-card', { product }) %><% }) %></div>
  </section>
  <section class="philosophy section-pad" id="about">
    <span class="eyebrow">PHILOSOPHY</span>
    <h2>BUILT FOR THE<br>STREET</h2>
    <div class="value-grid">
      <article>
        <span>01</span>
        <h3>DURABILITY</h3>
        <p>Reinforced construction and heavyweight fabrics made for everyday movement.</p>
      </article>
      
      <article>
        <span>02</span>
        <h3>VERSATILITY</h3>
        <p>Utility-led pieces that move between changing weather and city rhythm.</p>
      </article>
      
      <article>
        <span>03</span>
        <h3>FORM</h3>
        <p>Relaxed, boxy silhouettes built around comfort without losing structure.</p>      
      </article>
      
      <article>
        <span>04</span>
        <h3>CULTURE</h3>
        <p>Designed in Saigon. Informed by concrete, noise, and life after dark.</p>
      </article>
    </div>
  </section>

  <section class="editorial">
    <img src="/images/editorial/material-study.png" alt="Camo fabric and zipper details">
    <div>
      <span class="eyebrow">MATERIAL STUDY / 450 GSM</span>
      <h2>CUT FROM<br>THE CONCRETE</h2>
      <p>Heavy fabric, reinforced seams, and deliberate proportions. Every detail is tested against the pace of the city.</p>
      <a class="text-link" href="/shop?category=outerwear">EXPLORE OUTERWEAR ↗</a>
    </div>
  </section>
</main>
<%- include('partials/footer') %>