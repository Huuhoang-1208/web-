<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Square Calculation</title>
</head>
<body>
    <h1>Square Calculation</h1>


    <form action="/square" method="post">

        <label>Side</label>
        <input
            type="number"
            name="side"
            step="any"
            required
        >

        <button type="submit">Tính</button>
    </form>

    <% if (result) { %>

        <h2>Kết quả</h2>

        <p>Cạnh: <%= result.side %></p>

        <p>Diện tích: <%= result.area %></p>

        <p>Chu vi: <%= result.perimeter %></p>

    <% } %>
</body>
</html>